# ---------------------------------------------------------------------------
# Case Control environment
# Copy to .env.local for local development. On Vercel, add these as
# Environment Variables in the project settings.
# ---------------------------------------------------------------------------

# Postgres connection string. Leave unset locally to use the embedded PGlite
# database in ./.pglite (no installation needed).
# Supabase: Project Settings > Database > Connection string > "Session pooler".
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Supabase Auth (Project Settings > API). When both are set, real sign-in is
# used; otherwise the app runs in development mode with a pick-a-user login.
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...   (the "anon" / "publishable" key)
# SUPABASE_SERVICE_ROLE_KEY=eyJ...       (server only; used to invite users and store files)

# Force development login even when Supabase is configured.
# AUTH_MODE=dev

# Public URL of the deployed app (used in emails and auth redirects).
# NEXT_PUBLIC_APP_URL=https://casecontrol.yourfirm.com

# Email reminders (https://resend.com). Without a key, reminders are only
# shown inside the app.
# RESEND_API_KEY=re_...
# REMINDER_FROM_EMAIL="Case Control <reminders@yourfirm.com>"

# Shared secret that protects the daily reminder job (/api/cron/reminders).
# CRON_SECRET=change-me
